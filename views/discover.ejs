<%- include("partials/header.ejs") %>

<% if (typeof hasError !== "undefined" && hasError) { %>
    <script>
        alert("Discover failed to load. Redirecting to library...");
        window.location.href = "/library";
    </script>
<% } %>

<div class="discover-container ">

    <div class="discover-header">

        <h1 class="discover-title">
            Discover Books
        </h1>

        <p class="discover-subtitle">
            Search for books and add them to your personal library
        </p>

    </div>


    
    <div class="search-section">

        <form action="/discover" method="GET" class="search-form">

            <input 
                type="text"
                name="query"
                class="search-input"
                placeholder="Search for books by title or author..."
                required
                value="<%= searchQuery %>" 
            >

            <button type="submit" class="search-button">
                🔍 Search
            </button>

        </form>

    </div>

    

    <% if(!books){%>
    <div class="empty-state">
        
        <p class="empty-text">Search for a title to start building your library</p>
    </div>

    <%}else if (books && books.length > 0) { %>

        
                <!-- Cards injected here -->

    <div class="results-container">
       <%  for(let book of books){%>
        <div class="book-card">

            <div class="book-cover-container">
                 <% if(!book.cover_i ){ %>
                        <img src="/images/default-cover.png" alt="Book cover">
                <% }else{ %>
                        <img src="https://covers.openlibrary.org/b/id/<%= book.cover_i  %>-S.jpg" alt="Book cover">
                <% } %>
            </div>

            <div class="book-info">

                    <h3 class="book-title">
                        <%= book.title || "Untitled Book" %>
                    </h3>

                    <p class="book-author">
                        <%= book.author_name[0] || "Untitled Author" %>
                    </p>

            </div>

            <div class="book-action">

                    <form action="/add-book" method="POST">

                        <input type="hidden" name="title" value="<%= book.title %>">

                        <input type="hidden" name="author" value="<%= book.author_name %>">

                        <input type="hidden" name="cover_id" value="<%= book.cover_i %>">
                        <input type="hidden" name="work_key" value="<%= book.key %>">

                        <button type="submit" class="add-book-button">

                            Add Book

                        </button>

                    </form>

                


            </div>


        </div>

        <% } %>
    </div>

    <% }else{ %>

        <div class="no-results-state">
            <h2 class="no-results-title">No results found</h2>
            <p class="no-results-text">Try a different search term or author name.</p>
        </div>
     
     <% } %>   
        
</div>


  <%- include('partials/footer.ejs'); -%>